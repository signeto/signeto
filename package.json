{
  "name": "signeto",
  "private": true,
  "version": "0.0.0",
  "description": "Signeto integration toolkit: protocol, adapter SDK, reference adapter, integration guide",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './adapters/**' build",
    "test": "pnpm -r --filter './packages/**' --filter './adapters/**' test",
    "lint": "pnpm -r --filter './packages/**' --filter './adapters/**' lint",
    "typecheck": "pnpm -r --filter './packages/**' --filter './adapters/**' typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.20.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
