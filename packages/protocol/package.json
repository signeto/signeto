{
  "name": "@signeto/protocol",
  "version": "0.1.0",
  "description": "Canonical action bytes (RFC 8785), display templates, receipts and signature verification for Signeto: the trust-path primitives every Signeto component shares.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./appattest": {
      "types": "./dist/appattest.d.ts",
      "import": "./dist/appattest.js"
    },
    "./appattest/testing": {
      "types": "./dist/appattest-testing.d.ts",
      "import": "./dist/appattest-testing.js"
    },
    "./androidkey": {
      "types": "./dist/androidkey.d.ts",
      "import": "./dist/androidkey.js"
    },
    "./androidkey/testing": {
      "types": "./dist/androidkey-testing.d.ts",
      "import": "./dist/androidkey-testing.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "keywords": [
    "signeto",
    "ai-agents",
    "approval",
    "webauthn",
    "receipts",
    "rfc8785",
    "mcp"
  ],
  "homepage": "https://github.com/signeto/signeto/tree/main/packages/protocol#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signeto/signeto.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/signeto/signeto/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts src/appattest.ts src/appattest-testing.ts src/androidkey.ts src/androidkey-testing.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo 'lint: todo'"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
