{
  "name": "@signeto/adapter-sdk",
  "version": "0.0.0",
  "description": "Signeto adapter interface: manifest, resolve/mint/custody/execute hooks, AdapterError, manifest validation.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo 'lint: todo'"
  },
  "dependencies": {
    "@signeto/protocol": "workspace:*"
  }
}
