{
  "name": "@signeto/adapter-sdk",
  "version": "0.1.0",
  "description": "Signeto adapter interface: manifest, resolve/mint/custody/execute hooks, AdapterError, manifest validation.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "keywords": [
    "signeto",
    "ai-agents",
    "adapter",
    "mcp"
  ],
  "homepage": "https://github.com/signeto/signeto/tree/main/packages/adapter-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signeto/signeto.git",
    "directory": "packages/adapter-sdk"
  },
  "bugs": {
    "url": "https://github.com/signeto/signeto/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo 'lint: todo'"
  },
  "dependencies": {
    "@signeto/protocol": "workspace:^"
  }
}
